        "partitions": [
          {
            "name": "Data Quality",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Data = PostgreSQL.Database(\"localhost:5433\", \"steam_reviews\", [Query=\"SELECT (metrics->>'empty_review_text')::bigint AS empty_review_text, (metrics->>'suspected_duplicate_key_excess')::bigint AS suspected_duplicate_key_excess, source, snapshot, loaded_at AT TIME ZONE 'Asia/Ho_Chi_Minh' AS loaded_at_local, (metrics->>'input_reviews')::bigint AS input_reviews, (metrics->>'valid_reviews')::bigint AS valid_reviews, (metrics->>'rejected_reviews')::bigint AS rejected_reviews, (metrics->>'invalid_app_id')::bigint AS invalid_app_id, (metrics->>'invalid_review_month')::bigint AS invalid_review_month, (metrics->>'invalid_recommendation')::bigint AS invalid_recommendation, (metrics->>'unknown_playtime')::bigint AS unknown_playtime, (metrics->>'unknown_author_activity')::bigint AS unknown_author_activity, (metrics->>'aggregate_reviews')::bigint AS aggregate_reviews, (metrics->>'processing_seconds')::double precision AS processing_seconds FROM monitoring.pipeline_quality WHERE source = 'raw' ORDER BY loaded_at DESC LIMIT 1\"])",
                "in",
                "    Data"
              ],
              "type": "m"
            }
          }
        ]
      },
