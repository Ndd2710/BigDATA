        "partitions": [
          {
            "name": "playtime_behavior",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"localhost:5433\", \"steam_reviews\"),",
                "    Data = Source{[Schema=\"analytics\", Item=\"playtime_behavior\"]}[Data],",
                "    WithSort = Table.AddColumn(Data, \"band_sort\", each if [playtime_band] = \"under_1h\" then 1 else if [playtime_band] = \"1_to_10h\" then 2 else if [playtime_band] = \"10_to_50h\" then 3 else if [playtime_band] = \"50h_plus\" then 4 else if [playtime_band] = \"unknown\" then 5 else 99, Int64.Type),",
                "    Labels = Table.TransformColumns(WithSort, {{\"playtime_band\", each if _ = \"under_1h\" then \"Dưới 1 giờ\" else if _ = \"1_to_10h\" then \"1 đến dưới 10 giờ\" else if _ = \"10_to_50h\" then \"10 đến dưới 50 giờ\" else if _ = \"50h_plus\" then \"Từ 50 giờ\" else if _ = \"unknown\" then \"Không rõ\" else _, type text}})",
                "in",
                "    Labels"
              ],
              "type": "m"
            }
          }
        ]
      },
