            "formatString": "#,0",
            "lineageTag": "16d60397-5e7c-49a2-b8e7-e083db685e8a"
          },
          {
            "name": "Số không đề xuất · Hoạt động",
            "expression": "SUM('Hoạt động'[reviews]) - SUM('Hoạt động'[recommendations])",
            "formatString": "#,0",
            "lineageTag": "089ed471-c3a3-41be-9344-3805c91c6c41"
          }
        ],
        "partitions": [
          {
            "name": "reviewer_activity",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"localhost:5433\", \"steam_reviews\"),",
                "    Data = Source{[Schema=\"analytics\", Item=\"reviewer_activity\"]}[Data],",
                "    WithSort = Table.AddColumn(Data, \"band_sort\", each if [activity_band] = \"under_5\" then 1 else if [activity_band] = \"5_to_19\" then 2 else if [activity_band] = \"20_plus\" then 3 else if [activity_band] = \"unknown\" then 4 else 99, Int64.Type),",
                "    Labels = Table.TransformColumns(WithSort, {{\"activity_band\", each if _ = \"under_5\" then \"Dưới 5 review\" else if _ = \"5_to_19\" then \"5–19 review\" else if _ = \"20_plus\" then \"Từ 20 review\" else if _ = \"unknown\" then \"Không rõ\" else _, type text}})",
                "in",
                "    Labels"
              ],
              "type": "m"
            }
          }
        ]
      },
